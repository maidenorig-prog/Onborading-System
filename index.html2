<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Onboarding System</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<style>
  html, body, #root { height: 100%; margin: 0; }
  body { -webkit-font-smoothing: antialiased; font-family: -apple-system, sans-serif; }
  #boot-msg { padding: 40px; color: #8A6E7C; font-size: 15px; line-height: 1.5; }
  #boot-msg.error { color: #A83A32; background: #F8E4E1; margin: 24px; border-radius: 10px; white-space: pre-wrap; }
  #boot-msg a { color: #B8006F; font-weight: 600; }
</style>
</head>
<body>
<div id="root"><div id="boot-msg">Loading Onboarding System&hellip;</div></div>

<script>
  const firebaseConfig = {
    apiKey: "AIzaSyBZ58W2aRmsDkAOr1aVGTR3OAlE3JvgiEI",
    authDomain: "onboarding-system-blo.firebaseapp.com",
    databaseURL: "https://onboarding-system-blo-default-rtdb.firebaseio.com",
    projectId: "onboarding-system-blo",
    storageBucket: "onboarding-system-blo.firebasestorage.app",
    messagingSenderId: "806638145415",
    appId: "1:806638145415:web:70f14ae590ad713f4bcd22",
  };

  const FIREBASE_NOT_CONFIGURED = firebaseConfig.databaseURL === "PASTE_YOUR_DATABASE_URL_HERE";

  let db = null;
  if (!FIREBASE_NOT_CONFIGURED) {
    firebase.initializeApp(firebaseConfig);
    db = firebase.database();
  }

  window.storage = {
    async get(key) {
      if (!db) return null;
      const snap = await db.ref(key).get();
      const val = snap.val();
      if (val === null || val === undefined) return null;
      return { key, value: val, shared: true };
    },
    async set(key, value) {
      if (!db) return null;
      await db.ref(key).set(value);
      return { key, value, shared: true };
    },
    async delete(key) {
      if (!db) return null;
      await db.ref(key).remove();
      return { key, deleted: true, shared: true };
    },
    async list() {
      return { keys: [], shared: true };
    },
  };

  window.storageSubscribe = function (key, onChange) {
    if (!db) return null;
    const ref = db.ref(key);
    const handler = (snap) => onChange(snap.val());
    ref.on("value", handler);
    return () => ref.off("value", handler);
  };

  function showBootError(msg, isConfig) {
    var el = document.getElementById("boot-msg");
    if (!el) {
      el = document.createElement("div");
      el.id = "boot-msg";
      document.getElementById("root").appendChild(el);
    }
    el.className = "error";
    if (isConfig) {
      el.innerHTML =
        "This page isn't connected to a shared database yet.<br><br>" +
        "Firebase console: <a href=\"https://console.firebase.google.com\" target=\"_blank\">console.firebase.google.com</a>";
    } else {
      el.textContent =
        "This page failed to load correctly.\n\n" + msg +
        "\n\nThis is almost always caused by a network/firewall/ad-blocker " +
        "blocking one of these required scripts:\n" +
        "  - cdn.tailwindcss.com\n" +
        "  - unpkg.com (React, React DOM)\n" +
        "  - gstatic.com (Firebase)\n\n" +
        "Try: a different network/Wi-Fi, disabling ad blockers for this page, " +
        "or opening this file in a different browser.";
    }
  }

  window.addEventListener("DOMContentLoaded", function () {
    if (typeof React === "undefined") {
      showBootError("React failed to load from unpkg.com.");
    } else if (typeof ReactDOM === "undefined") {
      showBootError("ReactDOM failed to load from unpkg.com.");
    } else if (typeof firebase === "undefined") {
      showBootError("Firebase failed to load from gstatic.com.");
    } else if (FIREBASE_NOT_CONFIGURED) {
      showBootError("", true);
    }
  });
</script>

<script>
const {
  useState,
  useEffect,
  useMemo,
  useCallback
} = React;

/* ---------- design tokens ---------- */
const C = {
  bg: "#FFF7FB",
  surface: "#FFFFFF",
  border: "#F6D3E6",
  borderStrong: "#F0B9DA",
  ink: "#2B1E27",
  inkSoft: "#8A6E7C",
  inkFaint: "#C79BB6",
  rose: "#FF0198",
  roseDark: "#B8006F",
  roseTint: "#FDE6F2",
  sage: "#4F7A5E",
  sageTint: "#E7F0E7",
  amber: "#B4791F",
  amberTint: "#FBEDD9",
  brick: "#A83A32",
  brickTint: "#F8E4E1",
  slate: "#5B6B78",
  slateTint: "#E7ECEF"
};
const FONT_IMPORT = "@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');";
const LOGO_SRC = "data:image/png;base64,";

/* ---------- data model helpers ---------- */
const uid = () => Math.random().toString(36).slice(2, 10);
const BLO_SYSTEM_DEFS = [{
  key: "quickbooks",
  label: "QuickBooks",
  steps: ["Invite sent", "Employee received invite", "Employee accepted invite", "Account fully set up"]
}, {
  key: "booker",
  label: "Booker",
  steps: ["Invite sent", "Employee received invite", "Employee accepted invite", "Account fully set up"]
}, {
  key: "franconnect",
  label: "FranConnect",
  steps: ["Invite sent", "Employee received invite", "Employee accepted invite", "Account fully set up"]
}, {
  key: "discord",
  label: "Discord",
  steps: ["Invite sent", "Employee joined", "Employee set up profile", "Added to required channels"]
}];
const LK_SYSTEM_DEFS = [{
  key: "quickbooks",
  label: "QuickBooks",
  steps: ["Invite sent", "Employee received invite", "Employee accepted invite", "Account fully set up"]
}, {
  key: "zenoti",
  label: "Zenoti",
  steps: ["Invite sent", "Employee received invite", "Employee accepted invite", "Account fully set up"]
}, {
  key: "lashbarlms",
  label: "LashBar LMS",
  steps: ["Invite sent", "Employee received invite", "Employee accepted invite", "Account fully set up"]
}, {
  key: "discord",
  label: "Discord",
  steps: ["Invite sent", "Employee joined", "Employee set up profile", "Added to required channels"]
}];
// Union of every system key across both brands, so employee records can hold
// data for any system regardless of which brand they currently belong to.
const ALL_SYSTEM_DEFS = [...BLO_SYSTEM_DEFS, ...LK_SYSTEM_DEFS.filter(s => !BLO_SYSTEM_DEFS.some(b => b.key === s.key))];
function isLashKind(emp) {
  return emp.position === "Lash Artist / Esthetician" || emp.location === "LashKind Kingwood";
}
function systemDefsFor(emp) {
  return isLashKind(emp) ? LK_SYSTEM_DEFS : BLO_SYSTEM_DEFS;
}
const STEP_STATUS_LABELS = ["Not started", "Invite sent", "Pending acceptance", "Pending acceptance", "Completed"];
const POSITIONS = ["Hair Stylist/Makeup Artist", "Guest Coordinator/Makeup Artist", "Lash Artist / Esthetician"];
const LOCATIONS = ["Blo Kingwood", "Blo Wood Reserve", "LashKind Kingwood"];
const TRAINING_VIDEOS = [{
  label: "Signature Pink Carpet Treatment",
  url: "https://bloblowdrybar.franconnect.net/fc/control/courseDetailedSummary?courseId=1210792797&pageID=1&cft=c86fff6f-5752-4702-b603-1aa233ccc979"
}, {
  label: "Blo University",
  url: "https://bloblowdrybar.franconnect.net/fc/control/planDetails?planID=7&status=15301&days=0&cft=c86fff6f-5752-4702-b603-1aa233ccc979"
}];
const LASHBAR_TRAINING_URL = "https://lashbar-training.trainercentralsite.com/clientapp/app/products/explore-products/all-courses";
const LASHBAR_COURSES = ["Experienced Stylist Onboarding", "LED Lashes", "Zenoti Training", "Lash Lift & Tint", "Yumi Brow Lamination", "Wax/Brow"];
const SERVICE_READINESS_ITEMS = ["Lash Extensions", "LED", "Lash Lift (With & Without Keratin)", "Brow Lamination", "Brow Shaping / Threading"];
const FRONT_DESK_MATERIALS = [{
  label: "Reservationist Training - Part 1",
  url: "https://drive.google.com/file/d/1nbnwR2hlGfr874pUOsuKzVY_gl3_I751/view?usp=sharing"
}, {
  label: "Reservationist Training - Part 2",
  url: "https://drive.google.com/file/d/1sM6zBYUyYsZMDQxaBe3uOniU8NrxgbnB/view?usp=sharing"
}, {
  label: "LashBar Course Catalog (LashKind)",
  url: LASHBAR_TRAINING_URL
}];
function newAccounts() {
  const o = {};
  ALL_SYSTEM_DEFS.forEach(s => {
    o[s.key] = {
      steps: [false, false, false, false]
    };
    if (s.key === "franconnect") {
      o[s.key].loginId = "";
      o[s.key].password = "";
      o[s.key].url = "";
    }
  });
  return o;
}
function blankEmployee() {
  return {
    id: uid(),
    firstName: "",
    lastName: "",
    email: "",
    phone: "",
    position: POSITIONS[0],
    location: LOCATIONS[0],
    address: "",
    startDate: "",
    employeeStatus: "New Hire",
    offerSent: false,
    offerSigned: false,
    licenseType: "Cosmetology",
    licenseNumber: "",
    licenseStatus: "Not Verified",
    licenseVerificationDate: "",
    licenseExpirationDate: "",
    licenseNotes: "",
    accounts: newAccounts(),
    i9: {
      completed: false,
      signed: false
    },
    training: TRAINING_VIDEOS.reduce((acc, v) => ({
      ...acc,
      [v.label]: false
    }), {}),
    lkTraining: LASHBAR_COURSES.reduce((acc, c) => ({
      ...acc,
      [c]: false
    }), {}),
    serviceReadiness: SERVICE_READINESS_ITEMS.reduce((acc, s) => ({
      ...acc,
      [s]: {
        courseDone: false,
        modelDone: false,
        openToGuests: false
      }
    }), {}),
    notes: [],
    history: [],
    archived: false,
    createdAt: new Date().toISOString()
  };
}
function addHistory(emp, text) {
  return {
    ...emp,
    history: [{
      id: uid(),
      date: new Date().toISOString(),
      text
    }, ...emp.history].slice(0, 50)
  };
}
function stepCount(steps) {
  let c = 0;
  for (const s of steps) {
    if (s) c++;
  }
  return c;
}
function systemStatus(steps) {
  return STEP_STATUS_LABELS[stepCount(steps)];
}
function i9Status(i9) {
  if (i9.completed && i9.signed) return "Completed & Signed";
  if (i9.completed || i9.signed) return "In Progress";
  return "Not Completed";
}
function i9Badge(i9) {
  const s = i9Status(i9);
  if (s === "Completed & Signed") return {
    icon: "\u{1F7E2}",
    label: s,
    color: C.sage,
    tint: C.sageTint
  };
  if (s === "In Progress") return {
    icon: "\u{1F7E1}",
    label: s,
    color: C.amber,
    tint: C.amberTint
  };
  return {
    icon: "\u{1F534}",
    label: s,
    color: C.brick,
    tint: C.brickTint
  };
}
function daysUntil(dateStr) {
  if (!dateStr) return null;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const d = new Date(dateStr + "T00:00:00");
  return Math.round((d - today) / 86400000);
}
function licenseDisplay(emp) {
  const raw = emp.licenseStatus;
  if (!emp.licenseNumber) {
    return {
      label: "Missing number",
      icon: "\u{1F534}",
      color: C.brick,
      tint: C.brickTint,
      verifiedForProgress: false
    };
  }
  if (raw === "Verified") {
    const dLeft = daysUntil(emp.licenseExpirationDate);
    if (dLeft !== null && dLeft < 0) {
      return {
        label: "Expired",
        icon: "\u{1F534}",
        color: C.brick,
        tint: C.brickTint,
        verifiedForProgress: false
      };
    }
    if (dLeft !== null && dLeft <= 30) {
      return {
        label: "Expiring soon",
        icon: "\u26A0\uFE0F",
        color: C.amber,
        tint: C.amberTint,
        verifiedForProgress: true
      };
    }
    return {
      label: "Verified",
      icon: "\u{1F7E2}",
      color: C.sage,
      tint: C.sageTint,
      verifiedForProgress: true
    };
  }
  if (raw === "Pending Verification") return {
    label: "Pending verification",
    icon: "\u{1F7E1}",
    color: C.amber,
    tint: C.amberTint,
    verifiedForProgress: false
  };
  if (raw === "Expired") return {
    label: "Expired",
    icon: "\u{1F534}",
    color: C.brick,
    tint: C.brickTint,
    verifiedForProgress: false
  };
  if (raw === "Invalid") return {
    label: "Invalid",
    icon: "\u{1F534}",
    color: C.brick,
    tint: C.brickTint,
    verifiedForProgress: false
  };
  return {
    label: "Not verified",
    icon: "\u{1F534}",
    color: C.brick,
    tint: C.brickTint,
    verifiedForProgress: false
  };
}
function offerDisplay(emp) {
  if (emp.offerSigned) return {
    label: "Signed",
    icon: "\u{1F7E2}",
    color: C.sage,
    tint: C.sageTint
  };
  if (emp.offerSent) return {
    label: "Sent, awaiting signature",
    icon: "\u{1F7E1}",
    color: C.amber,
    tint: C.amberTint
  };
  return {
    label: "Not sent",
    icon: "\u{1F534}",
    color: C.brick,
    tint: C.brickTint
  };
}
function overallProgress(emp) {
  const lk = isLashKind(emp);
  const cats = [emp.offerSent && emp.offerSigned, licenseDisplay(emp).verifiedForProgress, ...systemDefsFor(emp).map(sys => stepCount(emp.accounts[sys.key].steps) === 4), emp.i9.completed && emp.i9.signed, lk ? LASHBAR_COURSES.every(c => emp.lkTraining && emp.lkTraining[c]) : TRAINING_VIDEOS.every(v => emp.training && emp.training[v.label])];
  const done = cats.filter(Boolean).length;
  return Math.round(done / cats.length * 100);
}
function fullName(emp) {
  return `${emp.firstName} ${emp.lastName}`.trim() || "Unnamed employee";
}
function fmtDate(s) {
  if (!s) return "\u2014";
  const d = new Date(s + "T00:00:00");
  if (isNaN(d)) return "\u2014";
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric"
  });
}
function buildAttentionItems(employees) {
  const items = [];
  employees.forEach(emp => {
    if (emp.archived) return;
    const name = fullName(emp);
    if (!emp.offerSent) {
      items.push({
        level: "critical",
        name,
        msg: "Offer not yet sent",
        id: emp.id + "-offersent"
      });
    } else if (!emp.offerSigned) {
      items.push({
        level: "warning",
        name,
        msg: "Offer sent, not yet signed",
        id: emp.id + "-offersigned"
      });
    }
    if (!emp.licenseNumber) {
      items.push({
        level: "critical",
        name,
        msg: "License number missing",
        id: emp.id + "-lnum"
      });
    } else if (emp.licenseStatus === "Not Verified") {
      items.push({
        level: "warning",
        name,
        msg: "License not yet verified",
        id: emp.id + "-lnv"
      });
    } else if (emp.licenseStatus === "Pending Verification") {
      items.push({
        level: "warning",
        name,
        msg: "License pending verification",
        id: emp.id + "-lpv"
      });
    } else if (emp.licenseStatus === "Expired" || emp.licenseStatus === "Invalid") {
      items.push({
        level: "critical",
        name,
        msg: `License ${emp.licenseStatus.toLowerCase()}`,
        id: emp.id + "-lbad"
      });
    } else if (emp.licenseStatus === "Verified") {
      const dLeft = daysUntil(emp.licenseExpirationDate);
      if (dLeft !== null && dLeft < 0) {
        items.push({
          level: "critical",
          name,
          msg: "License expired",
          id: emp.id + "-lexp"
        });
      } else if (dLeft !== null && dLeft <= 30) {
        items.push({
          level: "warning",
          name,
          msg: `License expires in ${dLeft} day${dLeft === 1 ? "" : "s"}`,
          id: emp.id + "-lsoon"
        });
      }
    }
    systemDefsFor(emp).forEach(sys => {
      const c = stepCount(emp.accounts[sys.key].steps);
      if (c === 0) {
        items.push({
          level: "critical",
          name,
          msg: `${sys.label} invite not sent`,
          id: emp.id + "-" + sys.key + "-0"
        });
      } else if (c < 4) {
        items.push({
          level: "warning",
          name,
          msg: `${sys.label} invite pending acceptance`,
          id: emp.id + "-" + sys.key + "-p"
        });
      }
    });
    if (!emp.i9.completed) {
      items.push({
        level: "warning",
        name,
        msg: "I-9 not completed",
        id: emp.id + "-i9c"
      });
    } else if (!emp.i9.signed) {
      items.push({
        level: "warning",
        name,
        msg: "I-9 completed but not signed",
        id: emp.id + "-i9s"
      });
    }
    if (emp.startDate) {
      const started = daysUntil(emp.startDate);
      if (started !== null && started < -14 && overallProgress(emp) < 100) {
        items.push({
          level: "critical",
          name,
          msg: "Onboarding tasks overdue",
          id: emp.id + "-overdue"
        });
      }
    }
  });
  const order = {
    critical: 0,
    warning: 1,
    info: 2
  };
  return items.sort((a, b) => order[a.level] - order[b.level]);
}

